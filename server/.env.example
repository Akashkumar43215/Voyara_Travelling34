# ==========================================================
# VOYARA server settings
# Copy this file to ".env" and fill in your own values.
# NEVER commit ".env" or share it: it holds your secret keys.
# ==========================================================

# --- Server -------------------------------------------------
PORT=5000

# "development" while you build, "production" when the site is live.
# Production turns on stricter security and serves the built website.
NODE_ENV=development

# The address of your website, when it is hosted separately from this server
# (for example https://my-voyara.vercel.app). Several can be listed, separated by
# commas. Leave it out if this server also serves the website.
CLIENT_URL=http://localhost:5173

# --- Database (required) ------------------------------------
# Local MongoDB:   mongodb://127.0.0.1:27017/voyara_db
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/voyara_db
MONGO_URI=mongodb://127.0.0.1:27017/voyara_db

# --- Logins (required) --------------------------------------
# A long random secret that signs login tokens. Production needs 32+ characters.
# Create one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_value

# --- Map data: cities, nearby places, hotels, restaurants ---
# Free key from https://www.geoapify.com
GEOAPIFY_API_KEY=your_geoapify_api_key

# --- Images -------------------------------------------------
# Photos for states and places. Free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stock photos for hotels and places without their own picture.
# Free key from https://www.pexels.com/api
PEXELS_API_KEY=your_pexels_api_key

# --- Booking emails (optional) ------------------------------
# Leave out to keep emails switched off. Any SMTP service works (Gmail app password,
# Brevo, SendGrid, Mailgun...).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM="VOYARA <no-reply@example.com>"

# --- AI answers in the assistant (optional) -----------------
# Leave out to keep the assistant rule based. With a key, questions the rules cannot
# answer are passed to Claude, limited to travel help. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Online payments: Razorpay (optional) -------------------
# Leave out to keep the demo payment. With keys, the demo payment is switched OFF and
# guests pay through Razorpay's checkout. Start with TEST keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks: URL https://<your-site>/api/payments/razorpay/webhook,
# events payment.captured and order.paid, and the secret you choose goes here.
RAZORPAY_WEBHOOK_SECRET=
